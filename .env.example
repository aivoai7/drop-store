# Copy to .env and fill in what you need. Everything except DATABASE_URL is optional.

DATABASE_URL="postgresql://drop:drop@localhost:5433/drop_store?schema=public"

# Absolute URL used for payment redirects and links in email.
SITE_URL="http://localhost:3002"

# Protects /api/cron/cleanup. Vercel sends this automatically as a Bearer token.
CRON_SECRET="change-me"

# --- Payments ---------------------------------------------------------------
# Cards, Apple Pay and Google Pay via Stripe Checkout.
# Leave blank to run the demo checkout (no money moves).
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# PAYPAL_CLIENT_ID=""
# PAYPAL_CLIENT_SECRET=""
# PAYPAL_WEBHOOK_ID=""
# PAYPAL_ENV="sandbox"            # or "live"

# --- Email ------------------------------------------------------------------
# Without a key, emails are recorded as skipped and reset links appear on screen.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="DROP <hello@yourdomain.com>"

# --- Tax --------------------------------------------------------------------
# manual (default) | taxjar | stripe_tax
# TAX_PROVIDER="taxjar"
# TAXJAR_API_TOKEN=""
# TAXJAR_ENV="sandbox"            # or "production"
# STRIPE_TAX_ENABLED="true"

# --- Exchange rates ---------------------------------------------------------
# Leave blank to edit rates by hand at /admin/currencies.
# OPEN_EXCHANGE_RATES_APP_ID=""
# EXCHANGE_RATE_API_KEY=""

# --- Seeded admin -----------------------------------------------------------
# SEED_ADMIN_EMAIL="admin@drop.test"
# SEED_ADMIN_PASSWORD="<change-me>"

# --- Licence ----------------------------------------------------------------
# Leave LICENSE_SERVER_URL empty to disable enforcement (dev/staging).
# LICENSE_SERVER_URL="https://licence.yourdomain.com"
# LICENSE_KEY="DROP-XXXX-XXXX-XXXX-XXXX"
# LICENSE_PRODUCT="drop-store"
# LICENSE_CHECK_INTERVAL_MS="21600000"
# LICENSE_GRACE_MS="259200000"
